# Local dev default: zero-setup SQLite file. Note: SQLite `file:` URLs are
# resolved relative to prisma/schema.prisma, not the project root — this
# path lands at prisma/dev.db (do NOT write "file:./prisma/dev.db" here,
# that resolves to prisma/prisma/dev.db instead).
# Production: point at Supabase's SESSION-mode pooler (port 5432), with
# ?connection_limit=1 so each serverless invocation opens only one
# connection instead of Prisma's multi-connection default. Do NOT use the
# transaction-mode pooler (port 6543/pgbouncer) — this app relies on
# Prisma interactive transactions, which transaction-mode pgbouncer
# breaks under load. Supabase's direct connection host is IPv6-only and
# unreachable from most networks/serverless runtimes, so use the pooler
# host either way. See prisma/schema.prisma header comment.
DATABASE_URL="file:./dev.db"

# Base URL used to build links inside emails (status page, payment link).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Random long strings used to sign admin session cookies and private-file
# download links. Generate with: openssl rand -base64 32
SESSION_SECRET="dev-only-change-me-session-secret-please"
FILE_TOKEN_SECRET="dev-only-change-me-file-secret-please"

# Where uploaded payment slips are stored on disk (outside /public, never
# served directly — only via a signed, time-limited URL). Used only when
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY below are unset.
STORAGE_DIR="./private-storage"

# Optional — set both to store payment slips in a private Supabase Storage
# bucket (named "payment-slips") instead of local disk. Required in
# production (serverless filesystems don't persist uploads). Get these from
# Project Settings > API. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level
# Security — server-only, never expose it to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Leave empty to use the built-in dev email outbox (emails are logged to
# the database and viewable at /admin/emails instead of actually sending).
# Set to a real key to send through Resend (https://resend.com).
RESEND_API_KEY=""

# Seed data — first Super Admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@ecbfunrun.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"
