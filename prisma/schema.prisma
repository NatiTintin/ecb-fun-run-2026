// ECB Fun Run 2026 — data model.
//
// Provider is postgresql (Supabase in production). Enums are modeled as
// validated String fields (not Prisma `enum`) specifically so this file
// also works unchanged against SQLite for zero-setup local dev — just
// flip `provider` back to "sqlite" and point DATABASE_URL at a file.
//
// DATABASE_URL must point at Supabase's SESSION-mode pooler (port 5432),
// not the transaction-mode pooler (port 6543/pgbouncer) — this app relies
// heavily on Prisma interactive transactions (db.$transaction(async tx =>
// ...) in lib/workflow.ts and lib/registration.ts), which need a stable
// connection across multiple statements. Transaction-mode pgbouncer can
// hand different statements in the same transaction to different backend
// connections, breaking it under concurrent load. Supabase's direct
// connection host is IPv6-only and unreachable from most networks/
// serverless runtimes, so the session pooler (not the raw direct host)
// is the right target even outside of pgbouncer concerns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventSettings {
  id String @id @default("singleton")

  eventName             String @default("ECB Fun Run 2026")
  eventDate             DateTime
  registrationOpenAt    DateTime
  registrationCloseAt   DateTime
  // AUTO = follow the open/close dates above. FORCE_OPEN / FORCE_CLOSED let
  // an admin override the automatic date-based gate.
  registrationOverride  String   @default("AUTO")
  reservationExpiryMinutes Int   @default(60)
  childCriteriaNote     String  @default("")
  // Optional, admin-set-later age check (spec explicitly forbids hard-coding
  // a child-age cutoff). Null = no automatic flag. When set, the admin
  // registration detail page flags a mismatch between this and the
  // participant's declared Adult/Child category — informational only,
  // never blocks registration or approval.
  childMaxAgeYears      Int?

  price5kmAdult Int @default(790)
  price5kmChild Int @default(490)
  price3kmAdult Int @default(590)
  price3kmChild Int @default(290)

  bankName            String @default("")
  bankAccountName     String @default("")
  bankAccountNumber   String @default("")
  promptPayNumber     String @default("")
  promptPayQrImageUrl String @default("")
  paymentInstructions String @default("")

  organizerEmail String @default("")
  organizerPhone String @default("")
  lineContact    String @default("")

  emailSenderName String @default("ECB Fun Run 2026")
  emailReplyTo    String @default("")

  consentPolicyVersion  String @default("1.0")
  consentTextHealth     String @default("")
  consentTextMarketing  String @default("")
  consentTextCommunication String @default("")

  updatedAt DateTime @updatedAt
}

model Quota {
  id              String @id @default(cuid())
  distance        String // KM3 | KM5
  participantType String // ADULT | CHILD
  capacity        Int
  reservedCount   Int    @default(0)
  approvedCount   Int    @default(0)
  // Monotonically increasing, never decremented — used only to mint unique
  // human-readable registration IDs (ECB26-5A-0001). Distinct from
  // reservedCount/approvedCount, which move up and down with status.
  nextSequence    Int    @default(0)

  @@unique([distance, participantType])
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // SUPER_ADMIN | REGISTRATION_STAFF | BIB_STAFF
  createdAt    DateTime @default(now())

  auditLogs      AuditLog[]
  verifiedPayments Payment[] @relation("VerifiedBy")
  bibCollections BibCollection[]
  createdParticipants Participant[] @relation("CreatedByAdmin")
}

model Participant {
  id             String   @id @default(cuid())
  registrationId String   @unique

  fullName        String
  phone           String
  email           String
  participantType String // ADULT | CHILD
  distance        String // KM3 | KM5
  shirtSize       String // 3XS..4XL
  registrationFee Int

  // Collected for accident insurance, and so staff can verify a declared
  // Adult/Child category against actual date of birth.
  dateOfBirth DateTime
  idType      String // THAI_ID | PASSPORT
  idNumber    String

  registrationStatus String @default("SUBMITTED")
  // Bearer token for the participant's secure, no-login status page.
  statusToken     String   @unique

  // Section 7 "Participant Declaration" checkbox — distinct from the PAR-Q
  // section 6 acknowledgement stored on ParqResponse.
  declarationAccepted   Boolean  @default(false)
  declarationAcceptedAt DateTime?

  // UI language the participant registered in ("en" | "th") — used to pick
  // the language of transactional emails sent to them.
  preferredLocale String @default("en")

  createdByAdminId String?
  createdByAdmin   Admin?  @relation("CreatedByAdmin", fields: [createdByAdminId], references: [id])

  reservedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments   Payment[]
  parq       ParqResponse?
  consents   Consent[]
  qrCode     QrCode?
  bib        BibCollection?
  auditLogs  AuditLog[]
  emailLogs  EmailLog[]
}

model Payment {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  amount        Int
  slipUrl       String?
  paymentStatus String   @default("NOT_PAID") // NOT_PAID | SLIP_UPLOADED | UNDER_REVIEW | PAYMENT_ISSUE | VERIFIED
  uploadedAt    DateTime?
  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    Admin?   @relation("VerifiedBy", fields: [verifiedById], references: [id])
  issueReason   String?

  createdAt DateTime @default(now())
}

model ParqResponse {
  participantId String  @id
  participant   Participant @relation(fields: [participantId], references: [id])

  q1 Boolean
  q2 Boolean
  q3 Boolean
  q4 Boolean
  q5 Boolean
  q6 Boolean
  q7 Boolean

  hasHealthFlag       Boolean
  declarationAccepted Boolean
  acceptedAt          DateTime
}

model Consent {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  consentType   String // HEALTH | MARKETING | COMMUNICATION
  consentStatus String // CONSENT | NO_CONSENT
  policyVersion String
  consentedAt   DateTime @default(now())

  @@index([participantId])
}

model QrCode {
  participantId String   @id
  participant   Participant @relation(fields: [participantId], references: [id])
  token         String   @unique
  generatedAt   DateTime @default(now())
  status        String   @default("ACTIVE") // ACTIVE | REVOKED
}

model BibCollection {
  participantId String   @id
  participant   Participant @relation(fields: [participantId], references: [id])
  collected     Boolean  @default(false)
  collectedAt   DateTime?
  collectedById String?
  collectedBy   Admin?   @relation(fields: [collectedById], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  adminId       String?
  admin         Admin?   @relation(fields: [adminId], references: [id])
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id])
  action        String
  previousValue String? // JSON-encoded
  newValue      String? // JSON-encoded
  note          String?
  timestamp     DateTime @default(now())

  @@index([participantId])
  @@index([adminId])
}

model EmailLog {
  id            String   @id @default(cuid())
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id])
  toEmail       String
  subject       String
  bodyHtml      String
  kind          String // RECEIVED | PAYMENT_REMINDER | PAYMENT_ISSUE | APPROVED
  provider      String // DEV | RESEND
  success       Boolean  @default(true)
  sentAt        DateTime @default(now())
}
